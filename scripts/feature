#!/usr/bin/env bash
# Helper of the new-feature skill (.agents/skills/new-feature). The skill talks to the user and writes the
# spec; this script does the parts that need another model or Cezar. You can also run it yourself.
#
#   scripts/feature list                          the specs and where each one stands
#   scripts/feature audit <spec> --writer <id>    one audit of the spec by a model from another family
#   scripts/feature queue <spec>                  approve: commit the spec on main and send it to Cezar
#   scripts/feature reject <spec>                 mark a spec rejected (the file stays)
#   scripts/feature done <spec>                   after its branch is merged: mark it implemented and commit that
#   scripts/feature status <spec>                 where the spec's Cezar task stands: steps, review verdicts, next step
#   scripts/feature wait <spec> [--timeout <min>] block until the task stops (done, failed, or it needs someone),
#                                                 then print the status; exit 4 if it still runs after the timeout (25)
#   scripts/feature fix <spec> [--note <file>]    send the task back to the implementer with the newest second
#                                                 reviews; --note adds the owner's decisions from a file
#
# A spec with a line `Depends on: <spec path>` under its Status line is queued only when that spec is
# implemented (`done`); `list` shows the link.
#
# <spec> is a path, a file name, or the number from the list.
# --writer <id>    model id of whoever wrote the spec (e.g. claude-opus-5-5, gpt-6.1-sol); the reviewer is
#                  picked from another model family by the rules in .ai/review-matrix
# --reviewer <id>  use this reviewer instead
#
# The reviewer runs as headless Pi on JetBrains AI (scripts/pi-jbai) and changes nothing.
# Tracked: the spec. Not tracked: audits and the writer's replies, in .ai/runs/<spec name>/.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
MAIN="$(dirname "$(git -C "$HERE" rev-parse --path-format=absolute --git-common-dir)")"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "feature: run this inside the repository" >&2; exit 1; }
cd "$ROOT"

PI="$MAIN/scripts/pi-jbai"
SPECS=".ai/specs"
RUNS=".ai/runs"
MATRIX=".ai/review-matrix"
WORKFLOW="feature-from-spec"
CEZ_URL="${CEZ_API_URL:-http://127.0.0.1:4321}"
PI_TIMEOUT="${PI_TIMEOUT:-1800}"            # seconds for one audit
REVIEWER_TOOLS="read,grep,find,ls,bash"
MAX_AUDITS=3

OPT_WRITER="" OPT_REVIEWER="" OPT_TIMEOUT=25 OPT_NOTE=""

say()  { printf '%s\n' "$*"; }
warn() { printf 'feature: %s\n' "$*" >&2; }
die()  { warn "$*"; exit 1; }

# ---------------------------------------------------------------- models

MODELS=""
load_models() {
  [[ -n "$MODELS" ]] && return
  [[ -x "$PI" ]] || die "$PI not found; run scripts/dev.sh setup in $MAIN"
  MODELS="$("$PI" --list-models </dev/null 2>/dev/null | awk 'NR>1 && NF>=2 {print $1 "/" $2}')"
  [[ -n "$MODELS" ]] || die "Pi listed no models; check the key file (scripts/dev.sh check)"
}

model_id() { printf '%s' "${1#*/}"; }                     # jetbrains-ai/gpt-6.1-sol -> gpt-6.1-sol

family_of() {
  case "$(model_id "$1")" in
    claude*|*opus*|*sonnet*|*haiku*|*fable*) echo anthropic ;;
    gpt*|o[0-9]*|*codex*) echo openai ;; gemini*) echo google ;; grok*) echo xai ;; *) echo other ;;
  esac
}

resolve_model() { # full name or bare id -> full name as Pi lists it; empty if Pi does not offer it
  local in="$1"
  load_models
  if grep -qxF -- "$in" <<<"$MODELS"; then printf '%s' "$in"; return; fi
  awk -v id="$in" '{ m = $0; sub(/^[^\/]*\//, "", m) } m == id { print; exit }' <<<"$MODELS"
}

opposite_of() { # writer's model id (need not be one Pi offers) -> reviewer, by the matrix
  local id pat rev
  id="$(model_id "$1")"
  [[ -f "$MATRIX" ]] || return 0
  while read -r pat rev _; do
    [[ -z "$pat" || "$pat" == \#* ]] && continue
    # shellcheck disable=SC2254
    case "$id" in $pat) resolve_model "$rev"; return ;; esac
  done <"$MATRIX"
}

# ---------------------------------------------------------------- spec files and their state

spec_name()  { basename "$1" .md; }
state_dir()  { printf '%s/%s' "$RUNS" "$(spec_name "$1")"; }
state_get()  { local f; f="$(state_dir "$1")/state"; [[ -f "$f" ]] && sed -n "s/^$2=//p" "$f" | tail -1 || true; }
state_set()  { local d; d="$(state_dir "$1")"; mkdir -p "$d"; printf '%s=%s\n' "$2" "$3" >>"$d/state"; }

spec_files()  { [[ -d "$SPECS" ]] && find "$SPECS" -maxdepth 1 -name '*.md' | sort || true; }
spec_title()  { sed -n 's/^# *//p' "$1" | head -1; }
spec_status() { # the "Status:" line of a spec, lower case; "draft" if there is none
  local s
  s="$(sed -n 's/^[*_]*[Ss]tatus[*_]*:[*_]* *\([A-Za-z-]*\).*/\1/p' "$1" | head -1 | tr '[:upper:]' '[:lower:]')"
  printf '%s' "${s:-draft}"
}
set_status() { # spec status
  if grep -qiE '^[*_]*status[*_]*:' "$1"; then
    sed -i "0,/^[*_]*[Ss]tatus[*_]*:.*/s//Status: $2/" "$1"
  else
    sed -i "0,/^# .*/s//&\n\nStatus: $2/" "$1"
  fi
}

spec_deps() { # the paths on the spec's "Depends on:" lines (header only: before the first "## " heading)
  sed -n '/^## /q; s/^[*_]*[Dd]epends on[*_]*:[*_]* *//p' "$1" | sed 's/^`//; s/`.*$//; s/[[:space:]].*$//'
}

resolve_spec() { # path, file name, or number from the list -> path
  local in="${1:-}" f=""
  [[ -n "$in" ]] || die "which spec? give its path or its number from: scripts/feature list"
  if [[ "$in" =~ ^[0-9]+$ ]]; then f="$(spec_files | sed -n "${in}p")"
  elif [[ -f "$in" ]]; then f="$in"
  elif [[ -f "$SPECS/$in" ]]; then f="$SPECS/$in"
  elif [[ -f "$SPECS/$in.md" ]]; then f="$SPECS/$in.md"; fi
  [[ -n "$f" && -f "$f" ]] || die "spec not found: $in"
  realpath --relative-to="$ROOT" "$f"
}

# ---------------------------------------------------------------- commands

cmd_list() {
  local f i=0 v run n
  [[ -n "$(spec_files)" ]] || { say "No specs in $SPECS yet."; return; }
  printf '%3s  %-11s  %-34s  %s\n' "#" "status" "audit" "spec"
  while IFS= read -r f; do
    i=$((i + 1)); v="$(state_get "$f" verdict)"; run="$(state_get "$f" run)"; n="$(state_get "$f" audits)"
    printf '%3d  %-11s  %-34s  %s\n' "$i" "$(spec_status "$f")" "${run:+queued, }${v:-not audited}${n:+ (audit $n)}" "$f"
    printf '%54s%s\n' "" "$(spec_title "$f")"
    while IFS= read -r v; do
      [[ -n "$v" ]] || continue
      if [[ -f "$v" ]]; then printf '%54sdepends on %s (%s)\n' "" "$v" "$(spec_status "$v")"
      else printf '%54sdepends on %s (NOT FOUND)\n' "" "$v"; fi
    done < <(spec_deps "$f")
  done < <(spec_files)
}

cmd_audit() {
  local spec dir n reviewer audit earlier="" verdict rc=0 before after
  spec="$(resolve_spec "${1:-}")" || exit 1
  dir="$(state_dir "$spec")"; mkdir -p "$dir"
  n="$(( $(state_get "$spec" audits) + 1 ))"
  (( n <= MAX_AUDITS )) || die "$spec has had $MAX_AUDITS audits; the user decides from here (remove $dir to start over)"
  [[ -f ".agents/skills/om-pre-implement-spec/SKILL.md" ]] || die "skill om-pre-implement-spec is missing; run: scripts/dev.sh setup"

  if [[ -n "$OPT_REVIEWER" ]]; then
    reviewer="$(resolve_model "$OPT_REVIEWER")"; [[ -n "$reviewer" ]] || die "Pi does not offer the model $OPT_REVIEWER"
  else
    [[ -n "$OPT_WRITER" ]] || OPT_WRITER="$(state_get "$spec" writer)"
    [[ -n "$OPT_WRITER" ]] || die "say who wrote the spec: --writer <model id> (the reviewer is picked from another family)"
    reviewer="$(opposite_of "$OPT_WRITER")"
    [[ -n "$reviewer" ]] || die "no usable rule in $MATRIX for $(model_id "$OPT_WRITER"); name one with --reviewer"
    [[ "$(family_of "$reviewer")" != "$(family_of "$OPT_WRITER")" ]] \
      || warn "reviewer $(model_id "$reviewer") is from the same family as the writer $(model_id "$OPT_WRITER")"
    state_set "$spec" writer "$OPT_WRITER"
  fi
  state_set "$spec" reviewer "$reviewer"

  if (( n > 1 )); then
    earlier="This spec was revised after an earlier audit, which is at $dir/audit.$((n - 1)).md."
    [[ -f "$dir/reply.$((n - 1)).md" ]] && earlier+=" The reply of the writer to it is at $dir/reply.$((n - 1)).md."
    earlier+=" Check whether its findings are resolved, and raise something new only if it would make the
implementation go wrong.
"
  fi

  audit="$dir/audit.$n.md"
  say "Audit $n of $MAX_AUDITS: $(model_id "$reviewer") reads $spec (a few minutes) ..."
  before="$(git status --porcelain --untracked-files=all)"
  # stdin from /dev/null: with an open, non-terminal stdin `pi --print` waits for it to end.
  timeout "$PI_TIMEOUT" "$PI" --print --no-session --model "$reviewer" --tools "$REVIEWER_TOOLS" \
    --skill ".agents/skills/om-pre-implement-spec" "Use the om-pre-implement-spec skill on the spec at $spec.
Report only: change, commit and stash nothing.
${earlier}The writer works with the user in a chat. Start a finding with NEEDS USER: when only the user can settle it
(a decision about scope or behaviour, a recording that has to be made, access you do not have).
An open question does not block approval when the spec lists it and makes it the first task.
Give the full report as your answer. End it with exactly one last line, either
VERDICT: APPROVED   (the spec can be implemented as written)
or
VERDICT: CHANGES    (the spec has to change first)" </dev/null >"$audit" 2>"$audit.log" || rc=$?
  if [[ $rc -ne 0 || ! -s "$audit" ]]; then
    rm -f "$audit"; die "the audit failed or ran over ${PI_TIMEOUT}s (exit $rc), see $audit.log"
  fi
  rm -f "$audit.log"
  after="$(git status --porcelain --untracked-files=all)"
  [[ "$before" == "$after" ]] || warn "files changed while the audit ran (the reviewer is told to change nothing): check git status"

  verdict="$(tail -n 5 "$audit" | grep -oE 'VERDICT: *(APPROVED|CHANGES)' | tail -1 | sed 's/VERDICT: *//' || true)"
  if [[ -z "$verdict" ]]; then verdict="CHANGES"; warn "no clear verdict line in the audit; taken as CHANGES"; fi
  state_set "$spec" audits "$n"
  state_set "$spec" verdict "$verdict"
  say "Reviewer: $reviewer"
  say "Audit:    $audit"
  say "Needs the user: $(grep -c 'NEEDS USER:' "$audit" || true) finding(s)"
  [[ "$verdict" == CHANGES ]] && say "Reply:    write what you changed, finding by finding, to $dir/reply.$n.md before the next audit"
  say "VERDICT: $verdict"
}

cezar_serves_this_repo() {
  local root
  root="$(curl -fsS -m 5 "$CEZ_URL/api/v1/repo" 2>/dev/null | jq -r '.info.root // empty' 2>/dev/null)" || return 1
  [[ -n "$root" && "$(readlink -f "$root")" == "$(readlink -f "$ROOT")" ]]
}

cmd_queue() {
  local spec base branch run resp
  spec="$(resolve_spec "${1:-}")" || exit 1
  run="$(state_get "$spec" run)"
  [[ -z "$run" ]] || die "$spec is already in Cezar's queue (task $run)"
  base="$(jq -r '.baseBranch // "main"' .ai/agentic.config.json 2>/dev/null || echo main)"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  [[ "$branch" == "$base" ]] || die "approve specs on $base (you are on $branch): the task's worktree starts from $base"
  [[ "$(spec_status "$spec")" != rejected ]] || die "$spec is rejected; set its Status line back to draft first"
  local dep
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    [[ -f "$dep" ]] || die "$spec depends on $dep, which does not exist (fix its Depends on: line)"
    [[ "$(spec_status "$dep")" == implemented ]] \
      || die "$spec depends on $dep, which is $(spec_status "$dep"), not implemented. Merge that one first, then: scripts/feature done $dep"
  done < <(spec_deps "$spec")

  set_status "$spec" approved
  if [[ -n "$(git status --porcelain -- "$spec")" ]]; then
    git add -- "$spec"
    git commit -q -m "Spec: $(spec_title "$spec")" -- "$spec"
    say "Committed $spec on $base ($(git rev-parse --short HEAD)). Nothing is pushed."
  fi

  if ! curl -fsS -m 5 "$CEZ_URL/api/v1/health" >/dev/null 2>&1; then
    say "The spec is approved, but Cezar is not running at $CEZ_URL."
    say "Start it in another terminal:  scripts/dev.sh cezar"
    say "Then send the spec:            scripts/feature queue $spec"
    return 2
  fi
  cezar_serves_this_repo || die "the Cezar at $CEZ_URL serves another repository; start one here: scripts/dev.sh cezar"
  curl -fsS -m 5 "$CEZ_URL/api/v1/workflows" | grep -q "\"$WORKFLOW\"" || die "Cezar does not list the workflow $WORKFLOW"
  resp="$(curl -sS -m 30 -X POST -H 'content-type: application/json' \
    -d "$(jq -n --arg w "$WORKFLOW" --arg t "$spec" '{workflow: $w, task: $t}')" "$CEZ_URL/api/v1/runs")" \
    || die "Cezar did not accept the task"
  run="$(jq -r '.id // empty' <<<"$resp" 2>/dev/null)"
  [[ -n "$run" ]] || die "Cezar answered: $(head -c 300 <<<"$resp")"
  state_set "$spec" run "$run"
  say "In Cezar's queue: task $run, workflow $WORKFLOW. Watch it at $CEZ_URL"
}

cmd_reject() {
  local spec; spec="$(resolve_spec "${1:-}")" || exit 1
  set_status "$spec" rejected
  say "$spec is marked rejected. The file stays; nothing was committed."
}

cmd_done() {
  local spec base branch; spec="$(resolve_spec "${1:-}")" || exit 1
  base="$(jq -r '.baseBranch // "main"' .ai/agentic.config.json 2>/dev/null || echo main)"
  branch="$(git rev-parse --abbrev-ref HEAD)"
  [[ "$branch" == "$base" ]] || die "mark specs implemented on $base (you are on $branch), after the merge"
  [[ "$(spec_status "$spec")" == approved ]] || die "$spec is $(spec_status "$spec"); only an approved spec can be marked implemented"
  set_status "$spec" implemented
  git add -- "$spec"
  git commit -q -m "Spec implemented: $(spec_title "$spec")" -- "$spec"
  say "$spec is marked implemented ($(git rev-parse --short HEAD) on $base). Nothing is pushed."
}

# ---------------------------------------------------------------- the Cezar task of a spec

task_of() { # spec -> task id; the state file is written where `queue` ran, usually the main checkout
  local run; run="$(state_get "$1" run)"
  [[ -n "$run" ]] || run="$(sed -n 's/^run=//p' "$MAIN/$RUNS/$(spec_name "$1")/state" 2>/dev/null | tail -1)"
  [[ -n "$run" ]] || die "$1 has no Cezar task yet; send it with: scripts/feature queue $1"
  printf '%s' "$run"
}

task_json() { # task id -> the task record
  curl -fsS -m 10 "$CEZ_URL/api/v1/runs/$1" 2>/dev/null | jq -e '.run // .' 2>/dev/null \
    || die "Cezar at $CEZ_URL does not answer for task $1; start it with: scripts/dev.sh cezar"
}

cezar_root() { curl -fsS -m 5 "$CEZ_URL/api/v1/repo" 2>/dev/null | jq -r '.info.root // empty' 2>/dev/null; }

newest() { # folder, name prefix -> the file <prefix>-<n>.md with the highest n
  find "$1" -maxdepth 1 -name "$2-*.md" 2>/dev/null | sort -V | tail -1
}

last_verdict() { # log file, node id -> the verdict that node last ended with
  [[ -f "$1" ]] || return 0
  jq -r --arg s "$2" 'select(.type == "note" and .stepId == $s and ((.message // "") | startswith("verdict: "))) | .message[9:]' "$1" 2>/dev/null | tail -1
}

task_running() { case "$1" in queued|starting|running) return 0 ;; *) return 1 ;; esac; }

cmd_status() {
  local spec run j status root art log opus sol q f open
  spec="$(resolve_spec "${1:-}")" || exit 1
  run="$(task_of "$spec")"; j="$(task_json "$run")"
  status="$(jq -r '.status' <<<"$j")"
  root="$(cezar_root)"; art="$root/.ai/cezar/artifacts/$run"; log="$root/.ai/cezar/runs/$run.ndjson"

  say "Task $run for $spec"
  say "Status:    $status$(jq -r 'if .error then " (" + .error + ")" else "" end' <<<"$j"), cost $(jq -r '(.costUsd // 0) * 100 | round / 100' <<<"$j") USD"
  say "Branch:    $(jq -r '.branch // "-"' <<<"$j") in $(jq -r '.worktreePath // "-"' <<<"$j")"
  say "Steps:"
  jq -r '.steps[] | select(.status != "pending") | "  \(.status)\t\(.name // .id)\(if (.iterations // 1) > 1 then " (\(.iterations) times)" else "" end)"' <<<"$j" | column -t -s $'\t'

  opus="$(last_verdict "$log" second-review-opus)"; sol="$(last_verdict "$log" second-review-sol)"
  say "Second reviews:"
  f="$(newest "$art" second-review-opus)"; say "  Opus: ${opus:-no verdict}${f:+, report $f}"
  f="$(newest "$art" second-review-sol)";  say "  Sol:  ${sol:-no verdict}${f:+, report $f}"
  f="$(newest "$art" fix-reply)"; [[ -z "$f" ]] || say "  Implementer's reply: $f"
  [[ ! -f "$art/for-the-owner.md" ]] || say "For the owner (deviations, tasks only the owner can do): $art/for-the-owner.md"

  q="$(jq -r '.attentionRequest.questions[0].question // empty' <<<"$j")"
  open=0; [[ "$opus" == approve && "$sol" == approve ]] || open=1
  if task_running "$status"; then
    say "Next: it is still running. Wait for it with: scripts/feature wait $spec"
  elif [[ -n "$q" ]]; then
    say "Cezar asks the owner, in the cockpit at $CEZ_URL:"; sed 's/^/  | /' <<<"$q"
    say "Next: the owner answers there. Show them the reports first."
  elif [[ "$status" == waiting ]]; then
    say "Next: an agent's turn ended and its session is still open. After a fix (scripts/feature fix): read the"
    say "      reply file above, then get a fresh second review in the worktree: scripts/dev.sh review $spec"
    say "      The owner closes the session with Finish in the cockpit."
  elif [[ "$status" == failed || "$status" == cancelled ]]; then
    say "Next: tell the owner why it stopped. The branch and worktree are kept."
  elif [[ "$open" == 1 ]]; then
    say "Next: the second reviews are not clean. Do not hand over for testing. Tell the owner the open findings;"
    say "      on their word send the task back: scripts/feature fix $spec"
  else
    say "Next: both second reviews approve. Hand over for the test by hand: the air-test-handoff skill."
  fi
}

cmd_wait() {
  local spec run status deadline
  spec="$(resolve_spec "${1:-}")" || exit 1
  run="$(task_of "$spec")"
  deadline=$(( $(date +%s) + OPT_TIMEOUT * 60 ))
  while :; do
    status="$(task_json "$run" | jq -r '.status')"
    task_running "$status" || break
    if (( $(date +%s) >= deadline )); then
      say "Task $run is still $status after $OPT_TIMEOUT minutes. Run the same command again to keep waiting."
      return 4
    fi
    sleep 20
  done
  cmd_status "$spec"
}

cmd_fix() {
  local spec run j status root art opus sol text resp
  spec="$(resolve_spec "${1:-}")" || exit 1
  run="$(task_of "$spec")"; j="$(task_json "$run")"
  status="$(jq -r '.status' <<<"$j")"
  case "$status" in
    review|done|failed|cancelled) ;;
    waiting) die "task $run waits for an answer or has an open session; answer or finish it in the cockpit first" ;;
    *) die "task $run is $status; wait until it stops: scripts/feature wait $spec" ;;
  esac
  [[ -z "$OPT_NOTE" || -f "$OPT_NOTE" ]] || die "note file not found: $OPT_NOTE"
  root="$(cezar_root)"; art="$root/.ai/cezar/artifacts/$run"
  opus="$(newest "$art" second-review-opus)"; sol="$(newest "$art" second-review-sol)"
  [[ -n "$opus$sol" ]] || die "no second-review-*.md report in $art; nothing to send back"

  text="The second reviews of this branch asked for changes. The spec is $spec. Read AGENTS.md first.

Read these reports:${opus:+
- $opus}${sol:+
- $sol}

Fix every blocker and major, each with a test that fails without the fix. Fix a minor when it is cheap.
Leave findings that only the owner can resolve. If a finding is wrong, do not change the code for it.
Run \`npm run check && npm test\` until both pass. Commit on this branch; do not push and do not touch main.
Then write $art/fix-reply-<n>.md (<n> is 1 or the next free number): one line per finding id with
\"fixed in <commit>\", \"declined: <reason>\" or \"left: <reason>\". End your turn with that file's path."
  [[ -z "$OPT_NOTE" ]] || text+=$'\n\nThe owner decided:\n\n'"$(cat "$OPT_NOTE")"

  # runner claude: the implementer. The task's last session is a reviewer's and must not be reopened for this.
  resp="$(curl -sS -m 30 -X POST -H 'content-type: application/json' \
    -d "$(jq -n --arg t "$text" '{runner: "claude", text: $t}')" "$CEZ_URL/api/v1/runs/$run/continue")" \
    || die "Cezar did not accept the fix request"
  [[ "$(jq -r '.error // empty' <<<"$resp" 2>/dev/null)" == "" ]] || die "Cezar answered: $(jq -r .error <<<"$resp")"
  say "Sent task $run back to the implementer (Claude) with the newest second reviews."
  say "Wait for it:   scripts/feature wait $spec"
  say "When it stops: read the fix-reply file, then get a fresh second review in the worktree:"
  say "               (cd $(jq -r '.worktreePath // "<worktree>"' <<<"$j") && scripts/dev.sh review $spec)"
  say "The session stays open after the fix; close it with Finish in the cockpit."
}

# ---------------------------------------------------------------- arguments

ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --writer)    OPT_WRITER="${2:?--writer needs a value}"; shift 2 ;;
    --reviewer)  OPT_REVIEWER="${2:?--reviewer needs a value}"; shift 2 ;;
    --timeout)   OPT_TIMEOUT="${2:?--timeout needs minutes}"; shift 2 ;;
    --note)      OPT_NOTE="${2:?--note needs a file}"; shift 2 ;;
    -h|--help)   sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "${BASH_SOURCE[0]}"; exit 0 ;;
    *)           ARGS+=("$1"); shift ;;
  esac
done
command -v jq >/dev/null || die "jq is needed"

case "${ARGS[0]:-list}" in
  list)   cmd_list ;;
  audit)  cmd_audit "${ARGS[1]:-}" ;;
  queue)  cmd_queue "${ARGS[1]:-}" ;;
  reject) cmd_reject "${ARGS[1]:-}" ;;
  done)   cmd_done "${ARGS[1]:-}" ;;
  status) cmd_status "${ARGS[1]:-}" ;;
  wait)   cmd_wait "${ARGS[1]:-}" ;;
  fix)    cmd_fix "${ARGS[1]:-}" ;;
  *)      die "unknown command: ${ARGS[0]} (see --help)" ;;
esac
